<?xml version="1.0" encoding="utf-8"?>
<resources>

    //for matrix card icons

    <style name="MatrixCardsIcons">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    //for matrix card LinearLayouts

    <style name="MatrixCardsLinearLayouts">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
    </style>

    //for matrix card text

    <style name="MatrixCardsMatrixText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">@string/placeholder_matrix_text</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    //for ChangeMatrix Matrix Fields linear layouts

    <style name="ChangeMatrixLinearLayouts">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
    </style>

    //for ChangeMatrix Material Fields Containers

    <style name="ChangeMatrixFieldsContainer" parent="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:hint">@string/hint_textInputLayout</item>
    </style>
    
    //for ChangeMatrix Matrix Fields

    <style name="ChangeMatrixMaterialField">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:inputType">numberSigned</item>
        <item name="android:gravity">center</item>
    </style>

    //for EditMatrixFragment Keypad Material buttons

    <style name="EditMatrixFragMaterialButtons">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:backgroundTint">@color/black</item>
    </style>

    //for EditMatrixFragment Keypad Arrow CardViews

    <style name="EditMatrixFragNumpadCardViews">
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="cardCornerRadius">4dp</item>
    </style>

    //for EditMatrixFragment Keypad Arrow ImageViews

    <style name="EditMatrixFragNumpadImageBtns">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/light_blue_black</item>
        <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    //for Sub Matrix Checkboxes

    <style name="SubMatrixCheckBoxes">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:checked">true</item>
        <item name="android:gravity">center</item>
    </style>

    //for HomeKeyboard Card Buttons

    <style name="HomeKBCardButtons">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:padding">0dp</item>
        <item name="cardCornerRadius">5dp</item>
        <item name="android:backgroundTint">@color/home_numpad_mat_opr_bg_color</item>
        <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    //for HomeKeyboard Card Buttons TextViews

    <style name="HomeKBCardTextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/home_numpad_mat_opr_text_color</item>
        <item name="android:gravity">center</item>
    </style>

    //for HomeKeyboard Numpad Buttons

    <style name="HomeKBNumpadButtons">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginStart">1dp</item>
        <item name="android:layout_marginEnd">1dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/home_numpad_text_color</item>
        <item name="background">@color/home_numpad_button_color</item>
        <item name="android:padding">0px</item>
    </style>

    //for Material Sliders
    <style name="MatrixDimensionsSliders">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:stepSize">1</item>
        <item name="android:valueFrom">1</item>
        <item name="android:valueTo">5</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="haloColor">@color/blue_black</item>
        <item name="thumbColor">@color/blue_black</item>
        <item name="trackColorActive">@color/blue_black</item>
        <item name="trackColorInactive">@color/light_blue_black</item>
        <item name="tickColor">@color/blue_black</item>
    </style>

    //for Settings Default Matrix Preview Bullets
    <style name="DefaultMatrixPreviewBullets">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">10dp</item>
        <item name="srcCompat">@drawable/ic_nav_default_matrix_prev</item>
        <item name="android:tint">@color/blue_black</item>
    </style>

    //for About TextViews
    <style name="AboutTextViews">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="textAppearanceBody1">@style/TextAppearance.AppCompat.Medium</item>
    </style>
</resources>