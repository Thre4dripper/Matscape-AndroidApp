<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="60dp"
    android:background="@color/white">


    <ImageView
        android:id="@+id/resultCardDragButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_result_card_drag"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="@string/desc_drag_result" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ExpressionRecyclerView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/resultCardDragButton"
        app:layout_constraintEnd_toStartOf="@+id/DeleteResultButton"
        app:layout_constraintStart_toEndOf="@+id/resultCardDragButton"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/ResultCardMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/placeholder_result_msg"
        android:textColor="#F44336"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/ExpressionRecyclerView"
        app:layout_constraintTop_toBottomOf="@+id/ExpressionRecyclerView" />

    <ImageView
        android:id="@+id/DeleteResultButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/desc_delete_result"
        android:focusable="true"
        android:src="@drawable/ic_result_card_delete"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="TouchTargetSizeCheck" />

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:cardElevation="5dp"
        app:cardCornerRadius="5dp"
        android:layout_marginBottom="16dp"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ExpressionRecyclerView">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="5dp" />

            <LinearLayout
                android:id="@+id/linearLayout6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/linearLayout"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="@+id/guideline3"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/linearLayout7"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/linearLayout6"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/linearLayout8"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/linearLayout"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/linearLayout9"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/linearLayout7"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/guideline4"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/linearLayout8"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

                <TextView
                    style="@style/MatrixCardsMatrixText"
                    android:text="@string/placeholder_matrix_text" />

            </LinearLayout>

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_end="5dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>