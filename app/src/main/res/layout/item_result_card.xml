<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ResultCardCL"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/result_card_bg_color"
    android:minHeight="80dp">


    <ImageView
        android:id="@+id/resultCardDragButton"
        android:layout_width="wrap_content"
        android:layout_height="0px"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/result_card_bg_color"
        android:contentDescription="@string/desc_drag_result"
        android:src="@drawable/ic_result_card_drag"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/custom_accent_color" />


    <EditText
        android:id="@+id/ExpressionField"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="8dp"
        android:background="@null"
        android:hint="@string/hint_result_field"
        android:importantForAutofill="no"
        android:inputType="textNoSuggestions"
        app:layout_constraintBottom_toBottomOf="@+id/AddResultMatrixButton"
        app:layout_constraintEnd_toStartOf="@+id/AddResultMatrixButton"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/resultCardDragButton"
        app:layout_constraintTop_toTopOf="@+id/resultCardDragButton"
        tools:ignore="LabelFor" />

    <TextView
        android:id="@+id/ResultCardMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/placeholder_result_msg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/ExpressionField"
        app:layout_constraintTop_toBottomOf="@+id/ExpressionField" />

    <ImageView
        android:id="@+id/DeleteResultButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/desc_delete_result"
        android:focusable="true"
        android:src="@drawable/ic_result_card_delete"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/custom_accent_color"
        tools:ignore="TouchTargetSizeCheck" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ExpressionField">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/result_card_matrix_bg_color"
            android:padding="4dp">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="5dp" />

            <LinearLayout
                android:id="@+id/linearLayout6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/linearLayout7"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="@+id/guideline3"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/ResultCardTextView11"
                    style="@style/MatrixCardsMatrixText" />

                <TextView
                    android:id="@+id/ResultCardTextView21"
                    style="@style/MatrixCardsMatrixText" />

                <TextView
                    android:id="@+id/ResultCardTextView31"
                    style="@style/MatrixCardsMatrixText" />

                <TextView
                    android:id="@+id/ResultCardTextView41"
                    style="@style/MatrixCardsMatrixText" />

                <TextView
                    android:id="@+id/ResultCardTextView51"
                    style="@style/MatrixCardsMatrixText" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/linearLayout8"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/linearLayout6"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/ResultCardTextView12"
                    style="@style/MatrixCardsMatrixText" />

                <TextView
                    android:id="@+id/ResultCardTextView22"
                    style="@style/MatrixCardsMatrixText" />

                <TextView
                    android:id="@+id/ResultCardTextView32"
                    style="@style/MatrixCardsMatrixText" />

                <TextView
                    android:id="@+id/ResultCardTextView42"
                    style="@style/MatrixCardsMatrixText" />

                <TextView
                    android:id="@+id/ResultCardTextView52"
                    style="@style/MatrixCardsMatrixText" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/linearLayout9"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/linearLayout7"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/ResultCardTextView13"
                    style="@style/MatrixCardsMatrixText" />

                <TextView
                    android:id="@+id/ResultCardTextView23"
                    style="@style/MatrixCardsMatrixText" />

                <TextView
                    android:id="@+id/ResultCardTextView33"
                    style="@style/MatrixCardsMatrixText" />

                <TextView
                    android:id="@+id/ResultCardTextView43"
                    style="@style/MatrixCardsMatrixText" />

                <TextView
                    android:id="@+id/ResultCardTextView53"
                    style="@style/MatrixCardsMatrixText" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/linearLayout10"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/linearLayout8"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/ResultCardTextView14"
                    style="@style/MatrixCardsMatrixText" />

                <TextView
                    android:id="@+id/ResultCardTextView24"
                    style="@style/MatrixCardsMatrixText" />

                <TextView
                    android:id="@+id/ResultCardTextView34"
                    style="@style/MatrixCardsMatrixText" />

                <TextView
                    android:id="@+id/ResultCardTextView44"
                    style="@style/MatrixCardsMatrixText" />

                <TextView
                    android:id="@+id/ResultCardTextView54"
                    style="@style/MatrixCardsMatrixText" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/guideline4"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/linearLayout9"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/ResultCardTextView15"
                    style="@style/MatrixCardsMatrixText" />

                <TextView
                    android:id="@+id/ResultCardTextView25"
                    style="@style/MatrixCardsMatrixText" />

                <TextView
                    android:id="@+id/ResultCardTextView35"
                    style="@style/MatrixCardsMatrixText" />

                <TextView
                    android:id="@+id/ResultCardTextView45"
                    style="@style/MatrixCardsMatrixText" />

                <TextView
                    android:id="@+id/ResultCardTextView55"
                    style="@style/MatrixCardsMatrixText" />

            </LinearLayout>

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.90816325" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/CopyResultButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/desc_copy_result"
        android:focusable="true"
        android:src="@drawable/ic_mat_card_copy"
        app:layout_constraintBottom_toBottomOf="@+id/DeleteResultButton"
        app:layout_constraintEnd_toStartOf="@+id/DeleteResultButton"
        app:layout_constraintTop_toTopOf="@+id/DeleteResultButton"
        app:tint="@color/custom_accent_color" />

    <ImageView
        android:id="@+id/AddResultMatrixButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/desc_add_result_matrix"
        android:focusable="true"
        android:src="@drawable/ic_result_add_matrix"
        app:layout_constraintBottom_toBottomOf="@+id/DeleteResultButton"
        app:layout_constraintEnd_toStartOf="@+id/CopyResultButton"
        app:layout_constraintTop_toTopOf="@+id/DeleteResultButton"
        app:tint="@color/custom_accent_color" />

</androidx.constraintlayout.widget.ConstraintLayout>