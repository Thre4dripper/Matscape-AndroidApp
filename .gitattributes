# Normalize line endings across all platforms (Windows / macOS / Linux).
# Every text file is stored in the repo with LF and checked out with LF,
# regardless of the user's core.autocrlf setting.
* text=auto eol=lf

# Windows-only scripts must keep CRLF to run correctly
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Unix shell scripts must stay LF
gradlew  text eol=lf
*.sh     text eol=lf

# Binary files: never touch line endings, never diff/merge as text
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.mp3    binary
*.mp4    binary
*.ogg    binary
*.wav    binary
*.pdf    binary
*.zip    binary
*.jar    binary
*.aar    binary
*.apk    binary
*.aab    binary
*.keystore binary
*.jks    binary
*.so     binary
